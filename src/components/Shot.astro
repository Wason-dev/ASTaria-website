---
// 真实产品截图（虚构演示数据）。AVIF/WebP 多档宽度；首屏外懒加载。
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
  glow?: boolean;
  sizes?: string;
  [key: string]: unknown;
}
const { src, alt, caption, eager = false, glow = false, sizes = '(min-width: 1100px) 1200px, 94vw', ...rest } = Astro.props;
---

<figure class:list={['shot', { glow }]} {...rest}>
  <div class="frame">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1600]}
      sizes={sizes}
      quality={84}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot { position: relative; margin: 0; }
  .glow::before {
    content: '';
    position: absolute;
    inset: 8% 6% -10%;
    z-index: -1;
    background: radial-gradient(60% 55% at 50% 60%, rgb(236 211 164 / 0.22), transparent 70%);
    filter: blur(40px);
  }
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(10px, 1.4vw, 20px);
    aspect-ratio: 1600 / 1050;
    background: var(--bg-3);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 50px 120px -40px rgb(0 0 0 / 0.95);
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14);
  }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: 14px; color: var(--fg-3); font-size: 14px; line-height: 1.5; text-align: center; }
</style>
