---
import Icon from './Icon.astro';
import { repoUrl } from '../data/release';

interface Props { current: string }
const { current } = Astro.props;
const links = [
  { href: '/download/', label: '下载', id: 'download' },
  { href: '/changelog/', label: '更新记录', id: 'changelog' },
  { href: '/install/', label: '安装', id: 'install' },
  { href: '/security/', label: '安全与隐私', id: 'security' },
  { href: '/faq/', label: '常见问题', id: 'faq' },
];
---

<header class="nav">
  <div class="nav-in">
    <a class="word" href="/" aria-current={current === 'home' ? 'page' : undefined}>ASTaria</a>
    <nav aria-label="主导航">
      <ul class="links">
        {links.map((l) => <li><a href={l.href} aria-current={l.id === current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="gh" href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库（新窗口打开）"><Icon name="github" size={18} /></a>
    <details class="menu">
      <summary aria-label="打开导航"><Icon name="menu" size={20} /></summary>
      <nav class="sheet" aria-label="移动导航">
        <a href="/" aria-current={current === 'home' ? 'page' : undefined}>概览</a>
        {links.map((l) => <a href={l.href} aria-current={l.id === current ? 'page' : undefined}>{l.label}</a>)}
        <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only">（新窗口打开）</span></a>
      </nav>
    </details>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: 52px;
    background: rgb(0 0 0 / 0.58);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .nav-in {
    /* 导航栏占满整个宽度：标志靠左边、链接和 GitHub 靠右边（与应用顶栏一致） */
    display: flex; align-items: center; gap: 32px; height: 100%;
    padding: 0 clamp(20px, 2.6vw, 40px);
  }
  .word { font-size: 18px; font-weight: 600; letter-spacing: 0.01em; margin-right: auto; }
  .links { display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; }
  .links a { font-size: 13px; color: var(--fg-2); transition: color 200ms var(--ease); }
  .links a:hover, .links a[aria-current='page'] { color: var(--fg); }
  .gh { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: var(--fg-2); transition: color 200ms var(--ease), background-color 200ms var(--ease); }
  .gh:hover { color: var(--fg); background: rgb(255 255 255 / 0.08); }
  .menu { display: none; }
  .menu:not([open]) .sheet { display: none; }
  .menu summary { display: grid; place-items: center; width: 40px; height: 40px; list-style: none; cursor: pointer; color: var(--fg-2); }
  .menu summary::-webkit-details-marker { display: none; }
  .sheet {
    position: absolute; left: 0; right: 0; top: 100%; display: grid; padding: 12px var(--pad) 28px;
    background: rgb(10 10 11 / 0.96); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--line-2);
  }
  .sheet a { padding: 13px 0; font-size: 16px; font-weight: 500; color: var(--fg-2); border-bottom: 1px solid var(--line-2); }
  .sheet a[aria-current='page'] { color: var(--fg); }
  .menu[open] .sheet { animation: sheet-in 0.45s var(--ease) both; }
  .menu[open] .sheet a { animation: sheet-item 0.5s var(--ease) both; }
  .menu[open] .sheet a:nth-child(2) { animation-delay: 0.03s; } .menu[open] .sheet a:nth-child(3) { animation-delay: 0.06s; }
  .menu[open] .sheet a:nth-child(4) { animation-delay: 0.09s; } .menu[open] .sheet a:nth-child(5) { animation-delay: 0.12s; }
  .menu[open] .sheet a:nth-child(6) { animation-delay: 0.15s; } .menu[open] .sheet a:nth-child(7) { animation-delay: 0.18s; }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(-10px); } }
  @keyframes sheet-item { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .menu[open] .sheet, .menu[open] .sheet a { animation: none; } }
  @media (max-width: 820px) {
    nav .links { display: none; }
    .menu { display: block; }
    .nav-in { gap: 12px; }
  }
</style>
