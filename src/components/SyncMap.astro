---
// 画出来的数据边界：左边是你的电脑，API Key 留在这里；
// 只有加密的操作文件穿过视界进入共享文件夹，再到另一台电脑。
// 宽屏是一整块玻璃上横排三站；窄屏拆成三张竖排的小玻璃卡，用连线串起来（见 drawn.css）。
import Icon from './Icon.astro';
---

<div class="smap glass" data-glass data-reveal="up" data-play role="img" aria-label="示意图：API Key 留在这台电脑；同步目录里只有 AES-256-GCM 加密的操作文件，经共享文件夹到另一台电脑">
  <div class="smap-node me" data-reveal="up">
    <span class="smap-ring" aria-hidden="true"></span>
    <Icon name="laptop" size={30} />
    <p class="smap-t">这台电脑</p>
    <p class="smap-key"><Icon name="key-round" size={14} />API Key 留在这里</p>
  </div>
  <div class="smap-line">
    <span class="pk"><Icon name="file-lock" size={14} /></span>
    <span class="pk"><Icon name="file-lock" size={14} /></span>
    <span class="pk"><Icon name="file-lock" size={14} /></span>
    <p class="smap-cap mono">AES-256-GCM</p>
  </div>
  <div class="smap-node" data-reveal="up" data-delay="1">
    <Icon name="folder" size={30} />
    <p class="smap-t">共享文件夹</p>
    <p class="smap-s">只有加密的操作文件</p>
  </div>
  <div class="smap-line rev">
    <span class="pk"><Icon name="file-lock" size={14} /></span>
    <span class="pk"><Icon name="file-lock" size={14} /></span>
  </div>
  <div class="smap-node" data-reveal="up" data-delay="2">
    <Icon name="monitor" size={30} />
    <p class="smap-t">另一台电脑</p>
    <p class="smap-s">各自保留一份数据库</p>
  </div>
</div>
