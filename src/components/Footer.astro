---
import { release, releaseUrl, repoUrl, publishedDate } from '../data/release';
const cols = [
  { h: '产品', items: [['/', '概览'], ['/download/', '下载'], ['/changelog/', '更新记录']] },
  { h: '帮助', items: [['/install/', '安装说明'], ['/security/', '安全与隐私'], ['/faq/', '常见问题']] },
  { h: '源码', items: [[repoUrl, 'GitHub'], [releaseUrl, `${release.displayName} Release`], [`${repoUrl}/issues`, '反馈问题']] },
];
---

<footer class="foot">
  <div class="wrap">
    <p class="fine note">
      当前公开版本 <span class="mono">{release.version}</span>（{release.displayName}，预发布，{publishedDate}）。安装包只在 GitHub Releases 提供，本站只做展示与跳转。
      页面中的应用画面来自真实界面，演示数据为虚构。
    </p>
    <div class="cols">
      {cols.map((c) => (
        <div>
          <p class="h">{c.h}</p>
          {c.items.map(([href, label]) => {
            const ext = href.startsWith('http');
            return <a href={href} {...(ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{label}{ext && <span aria-hidden="true"> ↗</span>}{ext && <span class="sr-only">（新窗口打开）</span>}</a>;
          })}
        </div>
      ))}
    </div>
    <p class="fine legal">源码采用 Apache-2.0。ASTaria 名称与标识不随许可证授予商标权。本站不收集访客数据，没有统计脚本。</p>
  </div>
</footer>

<style>
  .foot { position: relative; z-index: 2; background: var(--bg-2); padding: 40px 0 32px; font-size: 12px; }
  .note { padding-bottom: 18px; border-bottom: 1px solid var(--line-2); }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 200px)); gap: 24px; padding: 24px 0; }
  .cols div { display: grid; gap: 8px; align-content: start; }
  .h { color: var(--fg-2); font-weight: 600; font-size: 12px; }
  .cols a { color: var(--fg-3); font-size: 12px; transition: color 200ms var(--ease); }
  .cols a:hover { color: var(--fg); text-decoration: underline; }
  .legal { padding-top: 18px; border-top: 1px solid var(--line-2); }
  @media (max-width: 600px) { .cols { grid-template-columns: 1fr 1fr; } }
</style>
