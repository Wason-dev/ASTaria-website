---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Shot from '../components/Shot.astro';
import '../styles/home.css';
import { release, releaseUrl, publishedDate } from '../data/release';
import homeIdle from '../assets/shots/home.png';
import home from '../assets/shots/home-receipt.png';
import planner from '../assets/shots/planner.png';
import focus from '../assets/shots/workbench-focus.png';
import freeTime from '../assets/shots/free-time.png';
import horizon from '../assets/shots/horizon.png';

const chapters = [
  { n: '01', k: '析熙', h: '说一句，它就排好了', p: '「物理实验报告明天交，大概 45 分钟。」析熙记下事项，放进今晚真实的空档。回执只写实际保存的内容，可以一起撤销。',
    img: home, alt: 'ASTaria 首页：析熙对话与下方回执，列出截止、用时、安排时段与撤销入口', facts: [['安排', '18:00–18:45'], ['用时', '45 分钟'], ['截止', '10/9']] },
  { n: '02', k: '日程', h: '调课，只动那一天', p: '放假、停课、临时换用另一天的课表，只作用于那几天。每周课表不动，单日活动和已排的任务照常保留。',
    img: planner, alt: 'ASTaria 日程周视图：10/5–10/6 放假，10/9 使用周三课表，10/10 周六使用周五课表', facts: [['放假', '10/5–10/6'], ['10/9', '周三课表'], ['10/10', '周五课表']] },
  { n: '03', k: '工作台', h: '现在，先做哪一件', p: '此刻能开始的事项排在最前，截止和用时就在旁边。进入专注，析熙结合手上这件事和你对话，还能附一张图片。',
    img: focus, alt: 'ASTaria 工作台专注：当前事项、任务步骤与析熙的输入框' },
  { n: '04', k: '余时', h: '持续的目标，自己找时间', p: '编程、英语阅读、速写。设定频率和单次时长，按周排进真实的空档，完成记录一直保留。',
    img: freeTime, alt: 'ASTaria 余时：编程、英语阅读和速写三个持续目标及未来日期的练习安排' },
  { n: '05', k: '弦轨', h: '一天，沿着地平线', p: '把事项排在一条地平线上：分组、调整顺序、换到别的日子。只改明天时，今天排满也不会挡住保存。',
    img: horizon, alt: 'ASTaria 弦轨：明天的多组事项，以及日期、排序和保存入口' },
];
---

<Base page="home" title="ASTaria" description="ASTaria 是本机优先的个人时间与事项应用：和析熙聊作业、计划或心愿，把任务放进课程和日常之间的真实空档。当前预发布版支持 macOS 13+ Apple Silicon 与 Windows x64 试验版。">
  <div class="bh" id="bh" aria-hidden="true"></div>

  <section class="hero" aria-labelledby="hero-h">
    <p class="tag" data-reveal><span class="mono">{release.version}</span>预发布</p>
    <h1 id="hero-h" class="word" data-reveal="word">ASTaria</h1>
    <p class="slogan" data-reveal data-delay="1">让时间有引力</p>
    <div class="cta" data-reveal data-delay="2">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />下载 {release.displayName}</a>
      <a class="btn btn-ghost" href={releaseUrl} target="_blank" rel="noopener noreferrer">Release<Icon name="arrow-up-right" /><span class="sr-only">（新窗口打开）</span></a>
    </div>
    <p class="meta" data-reveal data-delay="3">macOS 13+ Apple Silicon　·　Windows x64 试验版　·　<a href="/install/">安装说明</a></p>
  </section>

  <figure class="peek" data-reveal>
    <Shot src={homeIdle} alt="ASTaria 首页：黑洞场景、当天安排与析熙入口" eager sizes="(min-width: 1100px) 1100px, 94vw" />
  </figure>

  <p class="intro" data-reveal>本机优先的个人时间与事项应用。和析熙聊作业、计划或心愿，把任务放进课程与日常之间的真实空档。</p>

  {chapters.map((c, i) => (
    <section class:list={['ch', { flip: i % 2 === 1 }]} aria-labelledby={`c${c.n}`}>
      <figure class="pane pane-img" data-reveal>
        <Shot src={c.img} alt={c.alt} eager={i === 0} sizes="(min-width: 1100px) 900px, 92vw" />
      </figure>
      <div class="pane pane-text" data-reveal>
        <p class="num mono">{c.n}　{c.k}</p>
        <h2 id={`c${c.n}`} class="title">{c.h}</h2>
        <p class="body">{c.p}</p>
        {c.facts && (
          <dl class="facts">
            {c.facts.map(([k, v]) => <div><dt>{k}</dt><dd class="mono">{v}</dd></div>)}
          </dl>
        )}
      </div>
    </section>
  ))}

  <section class="vows-sec" aria-labelledby="c06">
    <p class="num mono" data-reveal>06　数据</p>
    <h2 id="c06" class="title" data-reveal>你的数据不越过视界</h2>
    <ul class="vows">
      <li data-reveal>事项、日程、对话、图片和记忆，保存在你自己的电脑上。</li>
      <li data-reveal data-delay="1">API Key 由钥匙串或 DPAPI 保护，不同步，也不进备份。</li>
      <li data-reveal data-delay="2">同步目录里只有 AES-256-GCM 加密的操作文件。共享文件夹本身不是端到端加密存储。</li>
      <li data-reveal data-delay="3">联网默认关闭。本站没有统计脚本。</li>
    </ul>
    <a class="more" href="/security/" data-reveal>安全与隐私的完整说明<Icon name="chevron-right" /></a>
  </section>

  <!-- 越过视界：推进程度跟着这一段的滚动走；全黑之后这行字离开，下载区在黑暗里出现 -->
  <div class="dive" data-cam="dive">
    <p class="dive-line" data-in-shadow>越过视界</p>
  </div>

  <section class="finale" aria-labelledby="fin">
    <h2 id="fin" class="word small" data-reveal>现在开始</h2>
    <div class="cta" data-reveal data-delay="1">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />下载 {release.displayName}</a>
      <a class="btn btn-ghost" href="/install/">安装说明</a>
    </div>
    <ul class="plats" data-reveal data-delay="2">
      {release.platforms.map((p) => <li><span class="pn">{p.name}</span><span class="status" data-s={p.status}>{p.statusLabel}</span></li>)}
    </ul>
    <p class="fine" data-reveal data-delay="3"><span class="mono">{release.version}</span>　{publishedDate}　Windows 为未签名试验版，本版实机安装、Windows 11 与自动升级尚未验收。<a href="/changelog/">更新记录</a></p>
  </section>

  <script>
    import { mountBlackHole } from '../scripts/blackhole';
    if (!mountBlackHole(document.getElementById('bh')!)) document.documentElement.classList.add('bh-off');
  </script>
</Base>
