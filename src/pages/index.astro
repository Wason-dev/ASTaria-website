---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Shot from '../components/Shot.astro';
import XixiChat from '../components/XixiChat.astro';
import DayGaps from '../components/DayGaps.astro';
import WeekShift from '../components/WeekShift.astro';
import SyncMap from '../components/SyncMap.astro';
import '../styles/drawn.css';
import '../styles/home.css';
import { release, releaseUrl, publishedDate } from '../data/release';
import homeIdle from '../assets/shots/home.png';
import home from '../assets/shots/home-receipt.png';
import planner from '../assets/shots/planner.png';
import plannerDay from '../assets/shots/planner-day.png';
import workbench from '../assets/shots/workbench.png';
import focus from '../assets/shots/workbench-focus.png';
import freeTime from '../assets/shots/free-time.png';
import horizon from '../assets/shots/horizon.png';

// 功能区：左边一列标题（点开显示说明），右边大画面；点击切换，不点时自动轮播。
const tabs = [
  { k: '日程', lead: '调课，只动那一天。', p: '10/5–10/6 放假，10/9 用周三课表，10/10 周六用周五课表。每周课表不动，校庆活动和已排的任务照常保留。',
    img: planner, alt: 'ASTaria 日程周视图：10/5–10/6 放假，10/9 使用周三课表，10/10 周六使用周五课表' },
  { k: '工作台', lead: '现在，先做哪一件。', p: '此刻能开始的事项排在最前，截止和用时就在旁边。进入专注，析熙结合手上这件事和你对话，还能附一张图片。',
    img: focus, alt: 'ASTaria 工作台专注：当前事项、任务步骤与析熙的输入框' },
  { k: '余时', lead: '持续的目标，自己找时间。', p: '编程、英语阅读、速写。各自保留频率、单次时长和截止，按周排进真实的空档，完成记录一直保留。',
    img: freeTime, alt: 'ASTaria 余时：编程、英语阅读和速写三个持续目标及未来日期的练习安排' },
  { k: '弦轨', lead: '一天，沿着地平线。', p: '在真实日期上查看分组、调整顺序、换到别的日子。只改明天时，今天排满也不会挡住保存。',
    img: horizon, alt: 'ASTaria 弦轨：明天的多组事项，以及日期、排序和保存入口' },
];
// 细节区：横向卡片
const cards = [
  { lead: '回执只写实际保存的内容。', p: '聊天保留析熙的回复，下方回执核对截止、用时和安排，可以一并撤销创建与排程。', img: home, alt: 'ASTaria 首页展开：析熙对话、执行回执与当天日历' },
  { lead: '调课当天，一眼看清。', p: '10/9 的周三课表、课程地点、已排任务和真实剩余空档，不用改整个每周课表。', img: plannerDay, alt: 'ASTaria 日程日视图：10 月 9 日临时使用周三课表' },
  { lead: '从能开始的那件事进入专注。', p: '工作台同时列出截止、用时与近期任务。', img: workbench, alt: 'ASTaria 工作台：真实事项、近期截止与专注入口' },
  { lead: '收起对话，回到黑洞。', p: '首页保留当天事项、日历与析熙入口。', img: homeIdle, alt: 'ASTaria 黑洞首页：当天安排与析熙入口' },
];
---

<Base page="home" title="ASTaria" description="ASTaria 是本机优先的个人时间与事项应用：和析熙聊作业、计划或心愿，把任务放进课程和日常之间的真实空档。当前预发布版支持 macOS 13+ Apple Silicon 与 Windows x64 试验版。">
  <div class="bh" id="bh" aria-hidden="true"></div>

  <section class="hero wrap" aria-labelledby="hero-h">
    <div class="hero-text">
    <p class="tag" data-reveal><span class="mono">{release.version}</span>预发布</p>
    <h1 id="hero-h" class="word" data-reveal="word">ASTaria</h1>
    <p class="slogan" data-reveal="up" data-delay="1">让时间有引力</p>
    <div class="cta" data-reveal="up" data-delay="2">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />下载 {release.displayName}</a>
      <a class="btn btn-ghost" href={releaseUrl} target="_blank" rel="noopener noreferrer">Release<Icon name="arrow-up-right" /><span class="sr-only">（新窗口打开）</span></a>
    </div>
    <p class="meta" data-reveal data-delay="3">macOS 13+ Apple Silicon　·　Windows x64 试验版　·　<a href="/install/">安装说明</a></p>
    </div>
    <div class="hole" data-hole aria-hidden="true"></div>
  </section>

  <!-- 和析熙聊 -->
  <section class="chat" data-dim aria-labelledby="x-h">
    <div class="chat-copy">
      <p class="eyebrow" data-reveal>析熙</p>
      <h2 id="x-h" class="headline" data-reveal="lines"><span class="ln"><span>说一句</span></span><span class="ln"><span>它就排好了</span></span></h2>
      <p class="chat-body" data-reveal="up">析熙读取你真实的课程和空档，把事项放进去。每次修改都有回执，<b>只写实际保存的内容</b>，可以一键撤销。</p>
      <p class="chat-note" data-reveal>演示对话，数据为虚构。</p>
    </div>
    <div class="chat-demo" data-reveal="up"><XixiChat /></div>
  </section>

  <!-- 空档：画出来的一天 -->
  <section class="gaps" aria-labelledby="g-h">
    <p class="eyebrow" data-reveal>排程</p>
    <h2 id="g-h" class="headline sm" data-reveal="lines"><span class="ln"><span>放进真实的空档</span></span></h2>
    <p class="gaps-body" data-reveal="up">析熙先看这一天已经被课程和任务占住的时间，再把新事项放进空着的时段，不和已有安排重叠。</p>
    <div data-reveal="up"><DayGaps /></div>
  </section>

  <!-- 功能区 -->
  <section class="features" aria-labelledby="f-h">
    <div class="feat" data-tabs>
      <div class="feat-side">
        <p class="eyebrow" data-reveal>每天用到的四个地方</p>
        <h2 id="f-h" class="headline sm" data-reveal="lines"><span class="ln"><span>从课表</span></span><span class="ln"><span>到一天的地平线</span></span></h2>
        <ul class="feat-list" data-reveal="up">
          {tabs.map((t, i) => (
            <li class:list={['fi', { on: i === 0 }]}>
              <button type="button" class="fi-btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`fd${i}`}><span class="fi-k">{t.k}</span><span class="fi-lead">{t.lead}</span><span class="fi-bar" aria-hidden="true"><i></i></span></button>
              <div class="fi-desc" id={`fd${i}`}><p>{t.p}</p></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="feat-stage" data-reveal="up">
        {tabs.map((t, i) => (
          <div class:list={['panel', { on: i === 0 }]}>{t.k === '日程' ? <WeekShift /> : <Shot src={t.img} alt={t.alt} sizes="(min-width: 1180px) 760px, 94vw" />}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- 细节区 -->
  <section class="details" aria-labelledby="d-h">
    <h2 id="d-h" class="headline sm" data-reveal="lines"><span class="ln"><span>每一处细节</span></span></h2>
    <div class="carousel" data-carousel>
      <ul class="track" data-reveal="up">
        {cards.map((c) => (
          <li class="card">
            <div class="card-img"><Shot src={c.img} alt={c.alt} sizes="(min-width: 1100px) 760px, 86vw" /></div>
            <p><strong>{c.lead}</strong>{c.p}</p>
          </li>
        ))}
      </ul>
      <div class="arrows">
        <button type="button" class="arrow" data-prev aria-label="上一张"><Icon name="chevron-left" size={20} /></button>
        <button type="button" class="arrow" data-next aria-label="下一张"><Icon name="chevron-right" size={20} /></button>
      </div>
    </div>
  </section>

  <!-- 数据 -->
  <section class="data" aria-labelledby="c06">
    <p class="eyebrow" data-reveal>数据</p>
    <h2 id="c06" class="headline" data-reveal="lines"><span class="ln"><span>你的数据</span></span><span class="ln"><span>不越过视界</span></span></h2>
    <div class="data-grid">
      <p class="data-body" data-reveal="up">事项、日程、对话、图片和记忆，<b>保存在你自己的电脑上</b>。API Key 由钥匙串或 DPAPI 保护，<b>不同步，也不进备份</b>。联网默认关闭，本站没有统计脚本。<a class="more" href="/security/">安全与隐私的完整说明<Icon name="chevron-right" /></a></p>
      <div class="spec" data-reveal="up" data-delay="1">
        <p class="spec-k">同步目录里只有加密的操作文件</p>
        <p class="spec-v mono">AES-256-GCM</p>
        <p class="spec-n">共享文件夹本身不是端到端加密存储。</p>
      </div>
    </div>
    <div class="data-map" data-reveal="up"><SyncMap /></div>
  </section>

  <!-- 越过视界：推进程度跟着这一段的滚动走，约三屏 -->
  <div class="dive" data-cam="dive">
    <p class="dive-line" data-in-shadow>越过视界</p>
  </div>

  <section class="finale" aria-labelledby="fin">
    <h2 id="fin" class="word small" data-reveal="word">现在开始</h2>
    <div class="cta" data-reveal="up" data-delay="1">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />下载 {release.displayName}</a>
      <a class="btn btn-ghost" href="/install/">安装说明</a>
    </div>
    <ul class="plats" data-reveal data-delay="2">
      {release.platforms.map((p) => <li><span class="pn">{p.name}</span><span class="status" data-s={p.status}>{p.statusLabel}</span></li>)}
    </ul>
    <p class="fine" data-reveal data-delay="3"><span class="mono">{release.version}</span>　{publishedDate}　Windows 为未签名试验版，本版实机安装、Windows 11 与自动升级尚未验收。<a href="/changelog/">更新记录</a></p>
  </section>

  <script>
    import { mountBlackHole } from '../scripts/blackhole';
    import { mountHome } from '../scripts/home';
    import { mountXixiDemo } from '../scripts/xixi-demo';
    if (!mountBlackHole(document.getElementById('bh')!)) document.documentElement.classList.add('bh-off');
    mountHome();
    mountXixiDemo();
  </script>
</Base>
