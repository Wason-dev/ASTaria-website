---
// 说明类页面：标题区与首页同一网格——文字在左栏，黑洞落在右栏的 [data-hole] 槽位里。
// 正文每一节是一块单独的亮玻璃卡片，滚到时依次浮现；有目录的页面，往下读时顶部浮出一条玻璃目录，标出正在读的那一节。
import Base from './Base.astro';
import '../styles/doc.css';

interface Props {
  title: string;
  description: string;
  page: string;
  eyebrow?: string;
  lead?: string;
  toc?: Array<[string, string]>;
}
const { title, description, page, eyebrow, lead, toc } = Astro.props;

---

<Base title={title} description={description} page={page}>
  <div class="bh" id="bh" aria-hidden="true"></div>
  <article class="doc">
    <header class="doc-head wrap">
      <div class="head-text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="t-1">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        {toc && (
          <nav class="toc" aria-label="本页目录">
            {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
          </nav>
        )}
      </div>
      <div class="hole" data-hole aria-hidden="true"></div>
    </header>
    {toc && (
      <nav class="spy glass" data-glass aria-label="本页目录（跟随）" data-spy>
        {toc.map(([id, label]) => <a href={`#${id}`} data-spy-to={id}>{label}</a>)}
      </nav>
    )}
    <div class="doc-body wrap" data-dim>
      <div class="sheet">
        <slot />
      </div>
    </div>
  </article>
  <script>
    import { mountBlackHole } from '../scripts/blackhole';
    import { mountGlass } from '../scripts/glass';
    const bh = document.getElementById('bh')!;
    // 每一节变成一块亮玻璃卡片（没有 JS 时 doc.css 里有一份不带高光的玻璃样式）
    const cards = [...document.querySelectorAll<HTMLElement>('.sheet > section, .sheet > details')];
    cards.forEach((c) => { c.classList.add('glass', 'card'); c.dataset.glass = ''; });
    if (!mountBlackHole(bh)) document.documentElement.classList.add('bh-off');
    mountGlass();
    // 问答卡片展开 / 收起：自己做高度动画（Safari 不支持 details 的 CSS 高度过渡）。
    // 只动、只裁卡片里的内容区，不裁卡片本身：更新记录左边的时间线画在卡片外面，裁卡片会让它在动画里消失
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLDetailsElement>('details.qa').forEach((d) => {
      const sum = d.querySelector('summary')!;
      const body = d.querySelector<HTMLElement>(':scope > div');
      d.classList.add('anim');
      if (d.open) d.classList.add('shown');
      let a: Animation | null = null;
      sum.addEventListener('click', (e) => {
        if (still || !body) { requestAnimationFrame(() => d.classList.toggle('shown', d.open)); return; }
        e.preventDefault();
        a?.cancel();
        const pad = getComputedStyle(body).paddingBottom;
        // 动画期间暂停背景黑洞的渲染（见 blackhole.ts），每次开始、结束各发一次，保证成对
        let held = true;
        dispatchEvent(new CustomEvent('astaria:busy', { detail: 1 }));
        const done = () => { body.style.overflow = ''; a = null; if (held) { held = false; dispatchEvent(new CustomEvent('astaria:busy', { detail: -1 })); } };
        body.style.overflow = 'hidden';
        if (!d.open) {
          d.open = true;
          const h = body.offsetHeight;
          requestAnimationFrame(() => d.classList.add('shown'));
          a = body.animate({ height: ['0px', `${h}px`], paddingBottom: ['0px', pad] }, { duration: 520, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
          a.onfinish = done;
        } else {
          d.classList.remove('shown');
          const h = body.offsetHeight;
          a = body.animate({ height: [`${h}px`, '0px'], paddingBottom: [pad, '0px'] }, { duration: 380, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' });
          a.onfinish = () => { d.open = false; done(); };
        }
        a.oncancel = done;
      });
    });
    // 卡片滚到时浮现
    const reveal = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); reveal.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.01 });
    cards.forEach((c) => reveal.observe(c));
    // 跟随目录：标题区滚出去以后出现；标出正在读的那一节，并把它滚到目录条的可见范围里
    const spy = document.querySelector<HTMLElement>('[data-spy]');
    if (spy) {
      const head = document.querySelector<HTMLElement>('.doc-head')!;
      const links = [...spy.querySelectorAll<HTMLAnchorElement>('[data-spy-to]')];
      const targets = links.map((a) => document.getElementById(a.dataset.spyTo!)).filter(Boolean) as HTMLElement[];
      let raf = 0, current = '';
      const tick = () => {
        raf = 0;
        spy.classList.toggle('show', head.getBoundingClientRect().bottom < 80);
        let id = targets[0]?.id ?? '';
        for (const t of targets) if (t.getBoundingClientRect().top < innerHeight * 0.35) id = t.id;
        if (id === current) return;
        current = id;
        links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.spyTo === id));
        const on = links.find((a) => a.dataset.spyTo === id);
        if (on) spy.scrollTo({ left: on.offsetLeft - spy.clientWidth / 2 + on.offsetWidth / 2, behavior: 'smooth' });
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
      tick();
    }
    // 复制按钮：复制目标元素的文本，图标换成对勾 1.6 秒。没有 JS 时文本本身仍可选中复制。
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', async () => {
        const el = document.getElementById(b.dataset.copy!);
        if (!el) return;
        try {
          await navigator.clipboard.writeText(el.textContent!.trim());
          b.dataset.done = 'true';
          b.setAttribute('aria-label', '已复制');
          setTimeout(() => { delete b.dataset.done; b.setAttribute('aria-label', b.dataset.label!); }, 1600);
        } catch {
          getSelection()?.selectAllChildren(el);
        }
      });
    });
  </script>
</Base>
