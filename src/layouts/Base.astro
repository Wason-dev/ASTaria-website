---
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { release } from '../data/release';

interface Props { title: string; description: string; page: string }
const { title, description, page } = Astro.props;
const fullTitle = page === 'home' ? 'ASTaria · 让时间有引力' : `${title} · ASTaria`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <!-- 标签页图标：透明底的银色三瓣（不是方块，Safari 不会给它加描边）。favicon.ico 放第一个：Safari 常常只认它。
         加到 iPhone 主屏幕用带深灰方块底的应用图标。这些只用作图标，页面里不放 -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="ASTaria" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="astaria-version" content={release.version} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <!-- 空心字（.hollow）：字填实后沿整体轮廓向外扩一圈、减去原来的字，只留外轮廓，颜色就是字本身的颜色。
         不用 text-stroke：系统字体的字形内部有重叠的笔画，描边会把这些交叉线也画出来 -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="hollow" x="-4%" y="-8%" width="108%" height="116%" color-interpolation-filters="sRGB">
        <feMorphology in="SourceGraphic" operator="dilate" radius="1.3" result="grow" />
        <feComposite in="grow" in2="SourceGraphic" operator="out" />
      </filter>
    </svg>
    <Nav current={page} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // 进场：元素进入视口时播放一次。没有 JS 时内容本来就可见。
      const els = document.querySelectorAll('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
      );
      els.forEach((el) => io.observe(el));
      // 后备：某些环境不触发 IntersectionObserver 时，按滚动位置补上，内容不会一直隐藏。
      const sweep = () => els.forEach((el) => !el.classList.contains('in') && el.getBoundingClientRect().top < innerHeight * 0.92 && el.classList.add('in'));
      addEventListener('scroll', sweep, { passive: true });
      setTimeout(sweep, 900);
    </script>
  </body>
</html>
